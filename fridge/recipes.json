[{"id":"h001","name":"애호박 새우볶음","cuisine":"한식","situation":["가정식"],"type":"볶음","flavor":["담백"],"main":["애호박","새우"],"time":20,"servings":2,"calories":130,"nutrition":{"carb":10,"protein":17,"fat":3},"ingredients":[{"name":"애호박","amount":"1개"},{"name":"칵테일새우","amount":"150g"},{"name":"대파","amount":"1/2대"},{"name":"다진 마늘","amount":"1큰술"},{"name":"소금","amount":"1/2작은술"},{"name":"참기름","amount":"1작은술"}],"steps":["애호박은 반달 모양으로 0.5cm 두께로 썬다.","팬에 기름을 두르고 다진 마늘을 약불에 볶아 향을 낸다.","새우를 넣어 겉면이 붉어질 때까지 볶는다.","애호박을 넣고 중불에서 3분간 볶는다.","소금으로 간하고 대파를 넣어 한 번 더 볶는다.","불을 끄고 참기름을 둘러 마무리한다."]},{"id":"h002","name":"두부김치","cuisine":"한식","situation":["술안주"],"type":"볶음","flavor":["매콤"],"main":["두부","김치","돼지고기"],"time":15,"servings":2,"calories":440,"nutrition":{"carb":22,"protein":30,"fat":27},"ingredients":[{"name":"두부","amount":"1모(300g)"},{"name":"묵은지","amount":"200g"},{"name":"돼지고기 앞다리살","amount":"150g"},{"name":"양파","amount":"1/2개"},{"name":"고춧가루","amount":"1큰술"},{"name":"설탕","amount":"1작은술"},{"name":"참기름","amount":"1큰술"}],"steps":["두부는 1cm 두께로 썰어 끓는 물에 3분간 데친다.","묵은지는 속을 털어내고 한입 크기로 썬다.","팬에 돼지고기를 볶다가 겉면이 익으면 양파를 넣는다.","김치와 고춧가루, 설탕을 넣고 중불에서 7분간 볶는다.","참기름을 두르고 불을 끈다.","접시 한쪽에 데친 두부를, 다른 쪽에 볶은 김치를 담아낸다."]},{"id":"h003","name":"달걀 대파국","cuisine":"한식","situation":["가정식"],"type":"국찌개","flavor":["담백"],"main":["달걀","대파"],"time":10,"servings":2,"calories":100,"nutrition":{"carb":4,"protein":8,"fat":5},"ingredients":[{"name":"달걀","amount":"2개"},{"name":"대파","amount":"1대"},{"name":"국간장","amount":"1큰술"},{"name":"다진 마늘","amount":"1/2작은술"},{"name":"물","amount":"4컵"},{"name":"소금","amount":"약간"}],"steps":["냄비에 물 4컵을 붓고 팔팔 끓인다.","국간장과 다진 마늘을 넣어 간을 맞춘다.","달걀을 곱게 풀어 끓는 국물에 천천히 흘려 붓는다.","달걀이 응고되면 젓지 말고 30초간 그대로 둔다.","송송 썬 대파를 넣고 소금으로 간을 본다.","불을 끄고 바로 그릇에 담아낸다."]},{"id":"h004","name":"된장찌개","cuisine":"한식","situation":["가정식"],"type":"국찌개","flavor":["짭짤"],"main":["두부","된장","애호박"],"time":25,"servings":2,"calories":260,"nutrition":{"carb":25,"protein":19,"fat":9},"ingredients":[{"name":"된장","amount":"2큰술"},{"name":"두부","amount":"1/2모"},{"name":"애호박","amount":"1/3개"},{"name":"양파","amount":"1/2개"},{"name":"감자","amount":"1개"},{"name":"청양고추","amount":"1개"},{"name":"멸치육수","amount":"3컵"}],"steps":["냄비에 멸치육수를 붓고 된장을 체에 걸러 푼다.","감자를 먼저 넣고 5분간 끓인다.","애호박과 양파를 넣어 5분 더 끓인다.","두부를 큼직하게 썰어 넣는다.","청양고추를 썰어 넣고 3분간 더 끓인다.","간을 보고 부족하면 된장을 조금 더 푼다."]},{"id":"h005","name":"김치찌개","cuisine":"한식","situation":["가정식"],"type":"국찌개","flavor":["얼큰"],"main":["김치","돼지고기","두부"],"time":30,"servings":2,"calories":420,"nutrition":{"carb":20,"protein":26,"fat":26},"ingredients":[{"name":"묵은지","amount":"300g"},{"name":"돼지고기 목살","amount":"200g"},{"name":"두부","amount":"1/2모"},{"name":"대파","amount":"1대"},{"name":"고춧가루","amount":"1큰술"},{"name":"다진 마늘","amount":"1큰술"},{"name":"물","amount":"3컵"}],"steps":["냄비에 돼지고기를 넣고 중불에서 겉면이 익을 때까지 볶는다.","한입 크기로 썬 김치를 넣고 5분간 함께 볶는다.","물 3컵을 붓고 센 불에서 끓인다.","끓어오르면 고춧가루와 다진 마늘을 넣는다.","중약불로 줄여 15분간 뭉근하게 끓인다.","두부와 대파를 넣고 5분 더 끓여 마무리한다."]},{"id":"h006","name":"제육볶음","cuisine":"한식","situation":["가정식","술안주"],"type":"볶음","flavor":["매콤"],"main":["돼지고기","양파"],"time":25,"servings":2,"calories":590,"nutrition":{"carb":22,"protein":48,"fat":33},"ingredients":[{"name":"돼지고기 앞다리살","amount":"400g"},{"name":"양파","amount":"1개"},{"name":"대파","amount":"1대"},{"name":"고추장","amount":"2큰술"},{"name":"고춧가루","amount":"1큰술"},{"name":"간장","amount":"1큰술"},{"name":"설탕","amount":"1큰술"},{"name":"다진 마늘","amount":"1큰술"}],"steps":["고추장, 고춧가루, 간장, 설탕, 다진 마늘을 섞어 양념장을 만든다.","돼지고기에 양념장을 버무려 15분간 재운다.","달군 팬에 재운 고기를 넣고 센 불에서 볶는다.","고기가 반쯤 익으면 양파를 넣는다.","중불로 줄여 양념이 졸아들 때까지 볶는다.","대파를 넣고 한 번 더 볶아 마무리한다."]},{"id":"h007","name":"계란말이","cuisine":"한식","situation":["가정식","아이들요리"],"type":"구이","flavor":["담백"],"main":["달걀","당근"],"time":15,"servings":2,"calories":230,"nutrition":{"carb":3,"protein":14,"fat":17},"ingredients":[{"name":"달걀","amount":"4개"},{"name":"당근","amount":"1/4개"},{"name":"대파","amount":"1/3대"},{"name":"소금","amount":"1/2작은술"},{"name":"식용유","amount":"1큰술"}],"steps":["당근과 대파를 아주 잘게 다진다.","달걀을 풀어 다진 채소와 소금을 넣고 잘 섞는다.","약불로 달군 팬에 기름을 얇게 두른다.","달걀물의 1/3을 부어 얇게 펴고 반쯤 익으면 돌돌 만다.","남은 달걀물을 나눠 부으며 같은 방법으로 말아 나간다.","한 김 식힌 뒤 한입 크기로 썰어낸다."]},{"id":"h008","name":"소고기 무국","cuisine":"한식","situation":["가정식"],"type":"국찌개","flavor":["담백"],"main":["소고기","무"],"time":30,"servings":3,"calories":130,"nutrition":{"carb":3,"protein":9,"fat":8},"ingredients":[{"name":"소고기 양지","amount":"200g"},{"name":"무","amount":"300g"},{"name":"대파","amount":"1대"},{"name":"국간장","amount":"2큰술"},{"name":"다진 마늘","amount":"1큰술"},{"name":"참기름","amount":"1큰술"},{"name":"물","amount":"5컵"}],"steps":["무는 나박하게 썰고 소고기는 한입 크기로 썬다.","냄비에 참기름을 두르고 소고기를 볶는다.","고기 겉면이 익으면 무를 넣고 함께 볶는다.","물 5컵을 붓고 센 불에서 끓인다.","끓어오르면 거품을 걷어내고 중약불로 20분간 끓인다.","국간장과 다진 마늘로 간하고 대파를 넣어 마무리한다."]},{"id":"h009","name":"시금치나물","cuisine":"한식","situation":["가정식"],"type":"무침","flavor":["고소"],"main":["시금치"],"time":10,"servings":2,"calories":120,"nutrition":{"carb":6,"protein":6,"fat":8},"ingredients":[{"name":"시금치","amount":"1단(300g)"},{"name":"다진 마늘","amount":"1작은술"},{"name":"국간장","amount":"1큰술"},{"name":"참기름","amount":"1큰술"},{"name":"통깨","amount":"1작은술"},{"name":"소금","amount":"약간"}],"steps":["시금치는 뿌리를 다듬고 흐르는 물에 깨끗이 씻는다.","끓는 물에 소금을 넣고 시금치를 30초간 데친다.","찬물에 헹궈 물기를 꼭 짜낸다.","볼에 시금치를 담고 국간장과 다진 마늘을 넣는다.","참기름을 두르고 손으로 조물조물 무친다.","통깨를 뿌려 그릇에 담아낸다."]},{"id":"h010","name":"감자조림","cuisine":"한식","situation":["가정식","아이들요리"],"type":"조림","flavor":["짭짤"],"main":["감자"],"time":20,"servings":2,"calories":470,"nutrition":{"carb":75,"protein":10,"fat":15},"ingredients":[{"name":"감자","amount":"3개"},{"name":"양파","amount":"1/2개"},{"name":"간장","amount":"3큰술"},{"name":"설탕","amount":"1큰술"},{"name":"물엿","amount":"1큰술"},{"name":"물","amount":"1컵"},{"name":"통깨","amount":"1작은술"}],"steps":["감자는 껍질을 벗기고 한입 크기로 깍둑썬다.","팬에 기름을 두르고 감자를 3분간 볶는다.","물 1컵과 간장, 설탕을 넣고 뚜껑을 덮어 끓인다.","10분 뒤 양파를 넣고 국물이 반으로 줄 때까지 조린다.","물엿을 넣고 윤기가 나게 버무린다.","통깨를 뿌려 마무리한다."]},{"id":"h011","name":"콩나물무침","cuisine":"한식","situation":["가정식"],"type":"무침","flavor":["고소"],"main":["콩나물"],"time":10,"servings":2,"calories":120,"nutrition":{"carb":6,"protein":7,"fat":8},"ingredients":[{"name":"콩나물","amount":"300g"},{"name":"대파","amount":"1/3대"},{"name":"다진 마늘","amount":"1작은술"},{"name":"소금","amount":"1/2작은술"},{"name":"참기름","amount":"1큰술"},{"name":"통깨","amount":"1작은술"}],"steps":["콩나물을 깨끗이 씻어 냄비에 담는다.","물 1/2컵을 붓고 뚜껑을 덮어 센 불에서 5분간 삶는다.","찬물에 헹궈 물기를 뺀다.","볼에 담고 다진 마늘, 소금, 송송 썬 대파를 넣는다.","참기름을 두르고 골고루 무친다.","통깨를 뿌려 그릇에 담아낸다."]},{"id":"h012","name":"오징어볶음","cuisine":"한식","situation":["가정식","술안주"],"type":"볶음","flavor":["매콤"],"main":["오징어","양파"],"time":25,"servings":2,"calories":580,"nutrition":{"carb":34,"protein":45,"fat":30},"ingredients":[{"name":"오징어","amount":"2마리"},{"name":"양파","amount":"1개"},{"name":"당근","amount":"1/3개"},{"name":"대파","amount":"1대"},{"name":"고추장","amount":"2큰술"},{"name":"고춧가루","amount":"1큰술"},{"name":"설탕","amount":"1큰술"},{"name":"다진 마늘","amount":"1큰술"}],"steps":["오징어는 내장을 제거하고 링 모양으로 썬다.","고추장, 고춧가루, 설탕, 다진 마늘을 섞어 양념장을 만든다.","달군 팬에 양파와 당근을 넣고 센 불에서 2분간 볶는다.","오징어를 넣고 물기가 나올 때까지 볶는다.","양념장을 넣고 센 불에서 재빨리 볶는다.","대파를 넣고 30초만 더 볶아 불을 끈다."]},{"id":"h013","name":"미역국","cuisine":"한식","situation":["가정식"],"type":"국찌개","flavor":["담백"],"main":["미역","소고기"],"time":25,"servings":3,"calories":50,"nutrition":{"carb":4,"protein":3,"fat":2},"ingredients":[{"name":"건미역","amount":"20g"},{"name":"소고기 양지","amount":"150g"},{"name":"국간장","amount":"2큰술"},{"name":"다진 마늘","amount":"1큰술"},{"name":"참기름","amount":"1큰술"},{"name":"물","amount":"5컵"}],"steps":["건미역을 찬물에 20분간 불린 뒤 여러 번 헹궈 물기를 짠다.","냄비에 참기름을 두르고 소고기를 볶는다.","불린 미역을 넣고 5분간 함께 볶는다.","물 5컵을 붓고 센 불에서 끓인다.","끓어오르면 중약불로 줄여 15분간 끓인다.","국간장과 다진 마늘로 간을 맞춰 마무리한다."]},{"id":"h014","name":"비빔밥","cuisine":"한식","situation":["가정식"],"type":"밥","flavor":["매콤"],"main":["밥","시금치","콩나물","달걀"],"time":20,"servings":2,"calories":690,"nutrition":{"carb":92,"protein":33,"fat":21},"ingredients":[{"name":"밥","amount":"2공기"},{"name":"시금치","amount":"100g"},{"name":"콩나물","amount":"100g"},{"name":"당근","amount":"1/2개"},{"name":"애호박","amount":"1/2개"},{"name":"달걀","amount":"2개"},{"name":"고추장","amount":"2큰술"},{"name":"참기름","amount":"1큰술"}],"steps":["시금치와 콩나물은 각각 데쳐 참기름과 소금으로 무친다.","당근과 애호박은 채 썰어 각각 팬에 살짝 볶는다.","달걀은 반숙 프라이로 부친다.","그릇에 밥을 담고 나물을 색색으로 둘러 올린다.","가운데에 달걀 프라이를 얹는다.","고추장과 참기름을 곁들여 낸다."]},{"id":"h015","name":"잡채","cuisine":"한식","situation":["가정식","아이들요리"],"type":"면","flavor":["짭짤"],"main":["당면","시금치","소고기"],"time":40,"servings":3,"calories":420,"nutrition":{"carb":70,"protein":14,"fat":10},"ingredients":[{"name":"당면","amount":"200g"},{"name":"소고기 채끝","amount":"150g"},{"name":"시금치","amount":"100g"},{"name":"양파","amount":"1개"},{"name":"당근","amount":"1/2개"},{"name":"목이버섯","amount":"30g"},{"name":"간장","amount":"4큰술"},{"name":"설탕","amount":"2큰술"},{"name":"참기름","amount":"2큰술"}],"steps":["당면을 끓는 물에 7분간 삶아 찬물에 헹군다.","삶은 당면에 간장 2큰술과 설탕 1큰술을 넣어 미리 밑간한다.","소고기는 채 썰어 간장과 설탕으로 양념해 볶는다.","양파, 당근, 목이버섯을 각각 채 썰어 팬에 볶는다.","시금치는 데쳐 물기를 짠 뒤 참기름에 무친다.","큰 볼에 모든 재료를 넣고 남은 양념으로 골고루 버무린다."]},{"id":"h016","name":"순두부찌개","cuisine":"한식","situation":["가정식"],"type":"국찌개","flavor":["얼큰"],"main":["순두부","달걀"],"time":20,"servings":2,"calories":280,"nutrition":{"carb":10,"protein":23,"fat":17},"ingredients":[{"name":"순두부","amount":"1봉(350g)"},{"name":"달걀","amount":"1개"},{"name":"돼지고기 다짐육","amount":"100g"},{"name":"고춧가루","amount":"2큰술"},{"name":"다진 마늘","amount":"1큰술"},{"name":"국간장","amount":"1큰술"},{"name":"대파","amount":"1/2대"},{"name":"물","amount":"2컵"}],"steps":["뚝배기에 기름을 두르고 고춧가루를 약불에 볶아 고추기름을 낸다.","돼지고기를 넣고 겉면이 익을 때까지 볶는다.","물 2컵을 붓고 센 불에서 끓인다.","순두부를 큼직하게 떠 넣는다.","국간장과 다진 마늘로 간하고 5분간 끓인다.","달걀을 깨 넣고 대파를 올려 불을 끈다."]},{"id":"y001","name":"알리오 올리오","cuisine":"양식","situation":["술안주"],"type":"면","flavor":["고소"],"main":["스파게티","마늘"],"time":15,"servings":2,"calories":690,"nutrition":{"carb":81,"protein":14,"fat":34},"ingredients":[{"name":"스파게티","amount":"200g"},{"name":"마늘","amount":"8쪽"},{"name":"페페론치노","amount":"3개"},{"name":"올리브유","amount":"5큰술"},{"name":"파슬리","amount":"1큰술"},{"name":"소금","amount":"1큰술"}],"steps":["끓는 물에 소금을 넣고 스파게티를 8분간 삶는다.","마늘은 얇게 편으로 썬다.","팬에 올리브유를 넉넉히 두르고 약불에서 마늘을 노릇하게 익힌다.","페페론치노를 부숴 넣고 30초간 볶는다.","면수 반 국자와 삶은 면을 넣고 센 불에서 30초간 버무린다.","파슬리를 뿌려 접시에 담아낸다."]},{"id":"y002","name":"크림 파스타","cuisine":"양식","situation":["가정식"],"type":"면","flavor":["고소"],"main":["스파게티","베이컨","생크림"],"time":20,"servings":2,"calories":1030,"nutrition":{"carb":86,"protein":30,"fat":61},"ingredients":[{"name":"스파게티","amount":"200g"},{"name":"베이컨","amount":"100g"},{"name":"생크림","amount":"200ml"},{"name":"양파","amount":"1/2개"},{"name":"마늘","amount":"3쪽"},{"name":"파르메산 치즈","amount":"3큰술"},{"name":"후추","amount":"약간"}],"steps":["끓는 물에 소금을 넣고 스파게티를 8분간 삶는다.","베이컨은 1cm 폭으로, 양파와 마늘은 잘게 썬다.","팬에 베이컨을 볶아 기름을 낸 뒤 마늘과 양파를 넣는다.","양파가 투명해지면 생크림을 붓고 약불에서 3분간 졸인다.","삶은 면을 넣고 소스가 면에 엉기도록 버무린다.","파르메산 치즈와 후추를 뿌려 마무리한다."]},{"id":"y003","name":"토마토 미트소스 파스타","cuisine":"양식","situation":["가정식","아이들요리"],"type":"면","flavor":["짭짤"],"main":["스파게티","소고기","토마토"],"time":30,"servings":2,"calories":830,"nutrition":{"carb":96,"protein":34,"fat":35},"ingredients":[{"name":"스파게티","amount":"200g"},{"name":"소고기 다짐육","amount":"200g"},{"name":"토마토 홀","amount":"400g"},{"name":"양파","amount":"1개"},{"name":"마늘","amount":"3쪽"},{"name":"올리브유","amount":"2큰술"},{"name":"소금","amount":"1작은술"},{"name":"설탕","amount":"1작은술"}],"steps":["양파와 마늘을 잘게 다진다.","팬에 올리브유를 두르고 마늘과 양파를 볶는다.","소고기를 넣고 덩어리를 풀어가며 익힌다.","토마토 홀을 으깨 넣고 중약불에서 15분간 졸인다.","소금과 설탕으로 간을 맞춘다.","삶은 스파게티를 소스에 넣고 버무려 접시에 담는다."]},{"id":"y004","name":"그릭 샐러드","cuisine":"양식","situation":[],"type":"샐러드","flavor":["새콤"],"main":["토마토","오이"],"time":10,"servings":2,"calories":360,"nutrition":{"carb":13,"protein":8,"fat":31},"ingredients":[{"name":"방울토마토","amount":"15개"},{"name":"오이","amount":"1개"},{"name":"적양파","amount":"1/4개"},{"name":"페타 치즈","amount":"80g"},{"name":"올리브","amount":"10알"},{"name":"올리브유","amount":"3큰술"},{"name":"레몬즙","amount":"1큰술"},{"name":"소금","amount":"약간"}],"steps":["방울토마토는 반으로 자르고 오이는 도톰하게 썬다.","적양파는 얇게 채 썰어 찬물에 5분간 담근다.","볼에 토마토, 오이, 물기 뺀 양파, 올리브를 담는다.","올리브유와 레몬즙, 소금을 섞어 드레싱을 만든다.","드레싱을 채소에 붓고 가볍게 버무린다.","페타 치즈를 큼직하게 부숴 올려 낸다."]},{"id":"y005","name":"감자 그라탕","cuisine":"양식","situation":["가정식","아이들요리"],"type":"구이","flavor":["고소"],"main":["감자","치즈"],"time":40,"servings":3,"calories":510,"nutrition":{"carb":63,"protein":14,"fat":23},"ingredients":[{"name":"감자","amount":"4개"},{"name":"생크림","amount":"200ml"},{"name":"우유","amount":"100ml"},{"name":"모짜렐라 치즈","amount":"150g"},{"name":"마늘","amount":"2쪽"},{"name":"버터","amount":"20g"},{"name":"소금","amount":"1작은술"},{"name":"후추","amount":"약간"}],"steps":["오븐을 200도로 예열한다.","감자는 껍질을 벗겨 0.3cm 두께로 얇게 썬다.","생크림과 우유에 다진 마늘, 소금, 후추를 섞는다.","버터를 바른 그릇에 감자를 겹겹이 깔고 크림물을 붓는다.","모짜렐라 치즈를 위에 고루 덮는다.","오븐에서 30분간 표면이 노릇해질 때까지 굽는다."]},{"id":"y006","name":"양송이 스프","cuisine":"양식","situation":["가정식"],"type":"국찌개","flavor":["고소"],"main":["양송이버섯"],"time":25,"servings":2,"calories":480,"nutrition":{"carb":27,"protein":13,"fat":37},"ingredients":[{"name":"양송이버섯","amount":"300g"},{"name":"양파","amount":"1/2개"},{"name":"버터","amount":"30g"},{"name":"밀가루","amount":"2큰술"},{"name":"우유","amount":"400ml"},{"name":"생크림","amount":"100ml"},{"name":"소금","amount":"1작은술"}],"steps":["양송이버섯과 양파를 얇게 썬다.","냄비에 버터를 녹이고 양파를 투명해질 때까지 볶는다.","양송이를 넣고 물기가 날아갈 때까지 볶는다.","밀가루를 뿌려 1분간 볶은 뒤 우유를 조금씩 부으며 젓는다.","한소끔 끓으면 불을 끄고 믹서에 곱게 간다.","냄비에 다시 붓고 생크림과 소금을 넣어 데워낸다."]},{"id":"c001","name":"계란볶음밥","cuisine":"중식","situation":["가정식","아이들요리"],"type":"밥","flavor":["짭짤"],"main":["밥","달걀"],"time":15,"servings":2,"calories":630,"nutrition":{"carb":75,"protein":18,"fat":28},"ingredients":[{"name":"밥","amount":"2공기"},{"name":"달걀","amount":"3개"},{"name":"대파","amount":"1대"},{"name":"당근","amount":"1/3개"},{"name":"굴소스","amount":"1큰술"},{"name":"간장","amount":"1큰술"},{"name":"식용유","amount":"3큰술"}],"steps":["대파는 송송 썰고 당근은 잘게 다진다.","센 불로 달군 팬에 기름을 두르고 대파를 볶아 파기름을 낸다.","달걀을 풀어 넣고 크게 저어 스크램블을 만든다.","당근을 넣고 1분간 볶는다.","밥을 넣고 주걱으로 눌러 펴가며 고슬하게 볶는다.","굴소스와 간장을 팬 가장자리에 둘러 넣고 센 불에서 마무리한다."]},{"id":"c002","name":"마파두부","cuisine":"중식","situation":["가정식"],"type":"볶음","flavor":["매콤"],"main":["두부","돼지고기"],"time":20,"s